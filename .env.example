# Local secrets. Never committed. See INSTALL.md → Secrets for where each one comes from and where else it lives.
CF_API_TOKEN=            # Cloudflare API token: "Edit Cloudflare Workers" template + Zone:DNS:Edit on outman.cc
CF_ZONE_ID=              # Cloudflare → outman.cc → Overview → API → Zone ID
CLOUDFLARE_ACCOUNT_ID=   # Cloudflare → Workers & Pages → Account ID
SHARE_TOKEN=             # random string; must match `wrangler secret put SHARE_TOKEN` on the worker
ARCHIVE_TOKEN=           # GitHub fine-grained PAT, repo share-archive only, Contents: read/write (they expire!)
